@article{silverOverviewHeuristicSolution2004,
	title = {An overview of heuristic solution methods},
	volume = {55},
	issn = {0160-5682},
	url = {https://doi.org/10.1057/palgrave.jors.2601758},
	doi = {10.1057/palgrave.jors.2601758},
	abstract = {Besides those analysts who are already familiar with a number of heuristic methods, this paper should also be of interest to those analysts and managers who, although not yet aware of specific heuristic approaches, are quite comfortable with the use of mathematical modelling as an aid to decision making. It is concerned with obtaining usable solutions to well-defined mathematical representations of real-world problem situations. Heuristic procedures are defined and reasons for their importance are listed. A wide variety of heuristic methods, including several metaheuristics, are described. In each case, references for further details, including applications, are provided. There is also considerable discussion related to performance evaluation.},
	number = {9},
	urldate = {2026-07-29},
	journal = {Journal of the Operational Research Society},
	publisher = {Taylor \& Francis},
	author = {Silver, E A},
	month = sep,
	year = {2004},
	note = {\_eprint: https://doi.org/10.1057/palgrave.jors.2601758},
	keywords = {heuristics, methodology, OR education},
	pages = {936--956},
	file = {Full Text PDF:C\:\\Users\\Admin\\Zotero\\storage\\FMZC8X2P\\Silver - 2004 - An overview of heuristic solution methods.pdf:application/pdf},
}

@article{altschulAminoAcidSubstitution1991,
	title = {Amino acid substitution matrices from an information theoretic perspective},
	volume = {219},
	issn = {0022-2836},
	url = {https://pmc.ncbi.nlm.nih.gov/articles/PMC7130686/},
	doi = {10.1016/0022-2836(91)90193-A},
	abstract = {Protein sequence alignments have become an important tool for molecular biologists. Local alignments are frequently constructed with the aid of a “substitution score matrix” that specifies a score for aligning each pair of amino acid residues. Over the years, many different substitution matrices have been proposed, based on a wide variety of rationales. Statistical results, however, demonstrate that any such matrix is implicitly a “log-odds” matrix, with a specific target distribution for aligned pairs of amino acid residues. In the light of information theory, it is possible to express the scores of a substitution matrix in bits and to see that different matrices are better adapted to different purposes. The most widely used matrix for protein sequence comparison has been the PAM-250 matrix. It is argued that for database searches the PAM-120 matrix generally is more appropriate, while for comparing two specific proteins with suspected homology the PAM-200 matrix is indicated. Examples discussed include the lipocalins, human α1B-glycoprotein, the cystic fibrosis transmembrane conductance regulator and the globins.},
	number = {3},
	urldate = {2026-07-29},
	journal = {Journal of Molecular Biology},
	author = {Altschul, Stephen F.},
	month = jun,
	year = {1991},
	pages = {555--565},
	file = {Full Text PDF:C\:\\Users\\Admin\\Zotero\\storage\\BUZ33IQU\\Altschul - 1991 - Amino acid substitution matrices from an information theoretic perspective.pdf:application/pdf},
}

@article{vaserFastAccurateNovo2017,
	title = {Fast and accurate de novo genome assembly from long uncorrected reads},
	url = {https://genome.cshlp.org/content/early/2017/04/07/gr.214270.116},
	doi = {10.1101/gr.214270.116},
	abstract = {The assembly of long reads from Pacific Biosciences and Oxford Nanopore Technologies typically requires resource-intensive error-correction and consensus-generation steps to obtain high-quality assemblies. We show that the error-correction step can be omitted and that high-quality consensus sequences can be generated efficiently with a SIMD-accelerated, partial-order alignment–based, stand-alone consensus module called Racon. Based on tests with PacBio and Oxford Nanopore data sets, we show that Racon coupled with miniasm enables consensus genomes with similar or better quality than state-of-the-art methods while being an order of magnitude faster.},
	language = {en},
	urldate = {2026-08-20},
	publisher = {Cold Spring Harbor Laboratory Press},
	author = {Vaser, Robert and Sović, Ivan and Nagarajan, Niranjan and Šikić, Mile},
	month = apr,
	year = {2017},
	keywords = {Genome assembly},
	file = {Full Text PDF:C\:\\Users\\Admin\\Zotero\\storage\\RBNIFQQL\\Vaser et al. - 2017 - Fast and accurate de novo genome assembly from long uncorrected reads.pdf:application/pdf},
}

